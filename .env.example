# Supabase project credentials — Project Settings -> API in the Supabase dashboard.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# The anon key is a public client key (safe to ship in the app bundle); RLS is what
# protects data, so do NOT rely on secrecy of this key — re-enable RLS before real use.
EXPO_PUBLIC_SUPABASE_URL=your_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
